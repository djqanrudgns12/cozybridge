{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Linebound",
  "version": "0.1.0",
  "identifier": "com.linebound.game",
  "build": {
    "beforeDevCommand": "pnpm --filter @linebound/game dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --filter @linebound/game build",
    "frontendDist": "../game/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Linebound",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
